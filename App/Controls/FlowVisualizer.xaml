<UserControl
    x:Class="NetStats.UI.Controls.FlowVisualizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="UserControl_SizeChanged">

    <Grid Background="Transparent">
        <!-- Subtle reference grid lines -->
        <Grid Margin="0,4,0,5" Opacity="0.08">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" Width="1" Background="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
            <Border Grid.Column="2" Width="1" Background="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
            <Border Grid.Column="3" Width="1" Background="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
        </Grid>
        <Border Height="1" VerticalAlignment="Center" Margin="0,0,0,5" Background="{StaticResource TextSecondaryBrush}" Opacity="0.08" />
        <Border Height="1" VerticalAlignment="Bottom" Margin="0,0,0,5" Background="{StaticResource AppBorderSubduedBrush}" Opacity="0.35" />


        <!-- Visualization Canvas with Layered Signal Streams -->
        <Canvas x:Name="VisualizationCanvas" IsHitTestVisible="False">
            <!-- Download Volumetric Area Fill -->
            <Polygon x:Name="DownloadAreaPolygon" Fill="{StaticResource DownloadAreaBrush}" />
            
            <!-- Download Primary Crest Signal -->
            <Polyline x:Name="DownloadPolyline"
                      Stroke="{StaticResource DownloadFlowBrush}"
                      StrokeThickness="2.0"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />

            <!-- Upload Volumetric Area Fill -->
            <Polygon x:Name="UploadAreaPolygon" Fill="{StaticResource UploadAreaBrush}" />
            
            <!-- Upload Primary Crest Signal -->
            <Polyline x:Name="UploadPolyline"
                      Stroke="{StaticResource UploadFlowBrush}"
                      StrokeThickness="2.0"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />

            <!-- Download Leading-Edge Pulse Node -->
            <Ellipse x:Name="DownloadBeaconAura" Width="8" Height="8" Fill="{StaticResource DownloadFlowBrush}" Opacity="0.30" />
            <Ellipse x:Name="DownloadBeacon" Width="3" Height="3" Fill="{StaticResource TextPrimaryBrush}" />

            <!-- Upload Leading-Edge Pulse Node -->
            <Ellipse x:Name="UploadBeaconAura" Width="8" Height="8" Fill="{StaticResource UploadFlowBrush}" Opacity="0.30" />
            <Ellipse x:Name="UploadBeacon" Width="3" Height="3" Fill="{StaticResource TextPrimaryBrush}" />
        </Canvas>
    </Grid>
</UserControl>
