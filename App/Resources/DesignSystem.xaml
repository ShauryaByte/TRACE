<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Code, Consolas, monospace</FontFamily>

    <!-- Spacing Scale -->
    <x:Double x:Key="Space4">4</x:Double>
    <x:Double x:Key="Space8">8</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>
    <x:Double x:Key="Space20">20</x:Double>
    <x:Double x:Key="Space24">24</x:Double>
    <x:Double x:Key="Space32">32</x:Double>

    <!-- Responsive Typography: Dominant cinematic instrument numbers -->
    <x:Double x:Key="CompactHeroValueSize">34</x:Double>
    <x:Double x:Key="StandardHeroValueSize">42</x:Double>
    <x:Double x:Key="LargeHeroValueSize">52</x:Double>

    <!-- Responsive Layout: calibrated waveform bed heights -->
    <x:Double x:Key="CompactHeroSignalHeight">98</x:Double>
    <x:Double x:Key="StandardHeroSignalHeight">120</x:Double>
    <x:Double x:Key="LargeHeroSignalHeight">148</x:Double>
    <x:Double x:Key="ResponsiveStandardBreakpoint">420</x:Double>
    <x:Double x:Key="ResponsiveLargeBreakpoint">650</x:Double>

    <!-- Animation -->
    <Duration x:Key="AnimationFast">0:0:0.12</Duration>
    <Duration x:Key="AnimationStandard">0:0:0.18</Duration>
    <CubicEase x:Key="EaseStandard" EasingMode="EaseOut" />

    <!-- Corner Radius: 3-tier system -->
    <CornerRadius x:Key="SurfaceCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="MicroCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">99</CornerRadius>

    <!-- ============================================ -->
    <!-- COLOR SYSTEM: Rich Atmospheric Network Instrument -->
    <!-- ============================================ -->

    <!-- Surfaces: Deep space obsidian foundation -->
    <Color x:Key="AppBackgroundBaseColor">#060810</Color>
    <Color x:Key="AppBackgroundElevatedColor">#0E1320</Color>
    <Color x:Key="AppBackgroundCardColor">#141A29</Color>
    <Color x:Key="AppBackgroundHoverColor">#1E273D</Color>

    <!-- Atmospheric Saturated Accent Colors -->
    <Color x:Key="AtmosphereEmeraldColor">#00E599</Color>
    <Color x:Key="AtmosphereElectricBlueColor">#00A3FF</Color>
    <Color x:Key="AtmosphereCyanColor">#00F2FE</Color>
    <Color x:Key="AtmospherePlumColor">#8A2BE2</Color>
    <Color x:Key="AtmosphereDeepVioletColor">#4C1D95</Color>

    <!-- Borders -->
    <Color x:Key="AppBorderSubduedColor">#222A3C</Color>
    <Color x:Key="AppBorderBrightColor">#38445E</Color>

    <!-- Text: 3-level hierarchy with high contrast -->
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <!-- Data colors: Vivid Download (emerald) / Upload (electric blue) -->
    <Color x:Key="DownloadPrimaryColor">#00E599</Color>
    <Color x:Key="DownloadGlowColor">#5CFFC7</Color>
    <Color x:Key="DownloadDimColor">#0A422D</Color>
    <Color x:Key="UploadPrimaryColor">#00A3FF</Color>
    <Color x:Key="UploadGlowColor">#70C8FF</Color>
    <Color x:Key="UploadDimColor">#0E386B</Color>

    <!-- Accent: state-based, cyan/emerald instrument accent -->
    <Color x:Key="AccentPrimaryColor">#00F2FE</Color>
    <Color x:Key="AccentSecondaryColor">#0284C7</Color>
    <Color x:Key="AccentMutedColor">#0F3854</Color>
    <Color x:Key="AccentSurfaceColor">#1E00F2FE</Color>
    <Color x:Key="AccentSurfaceStrongColor">#3500F2FE</Color>
    <Color x:Key="AccentBorderColor">#5000F2FE</Color>
    <Color x:Key="AccentBorderStrongColor">#9000F2FE</Color>
    <Color x:Key="AccentGlowColor">#4500F2FE</Color>
    <Color x:Key="AccentTextColor">#38BDF8</Color>
    <Color x:Key="AccentHoverColor">#2500F2FE</Color>
    <Color x:Key="AccentPressedColor">#4500F2FE</Color>
    <Color x:Key="AccentFocusColor">#B000F2FE</Color>
    <Color x:Key="StatusLiveColor">#00E599</Color>

    <!-- ============================================ -->
    <!-- BRUSHES: Rich Atmospheric Network Instrument -->
    <!-- ============================================ -->

    <SolidColorBrush x:Key="AppBackgroundBaseBrush" Color="{StaticResource AppBackgroundBaseColor}" />
    <!-- MicaSurfaceBrush: Translucent dark tint allowing Desktop Acrylic glass blur through while giving deep body -->
    <SolidColorBrush x:Key="MicaSurfaceBrush" Color="#060810" Opacity="0.45" />
    <SolidColorBrush x:Key="SolidBackgroundElevatedBrush" Color="{StaticResource AppBackgroundElevatedColor}" />
    
    <!-- Dense dark glass settings surface: near-opaque to prevent bright peaks from bleeding through -->
    <LinearGradientBrush x:Key="SettingsOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FC0B0F1C" Offset="0.0" />
        <GradientStop Color="#FA060810" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Cyberpunk / Atmospheric Instrument Chassis Outer Rim Catch -->
    <LinearGradientBrush x:Key="AtmosphereChassisRimBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#858A2BE2" Offset="0.0" />
        <GradientStop Color="#406B21A8" Offset="0.25" />
        <GradientStop Color="#4000A3FF" Offset="0.65" />
        <GradientStop Color="#9500F2FE" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Secondary hairline rim for inner instrument boundaries -->
    <LinearGradientBrush x:Key="AtmosphereInnerRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5000F2FE" Offset="0.0" />
        <GradientStop Color="#1AFFFFFF" Offset="0.4" />
        <GradientStop Color="#358A2BE2" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Fading horizontal divider hairline -->
    <LinearGradientBrush x:Key="AtmosphericDividerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0.0" />
        <GradientStop Color="#28FFFFFF" Offset="0.3" />
        <GradientStop Color="#3000F2FE" Offset="0.5" />
        <GradientStop Color="#28FFFFFF" Offset="0.7" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Fading vertical divider hairline -->
    <LinearGradientBrush x:Key="AtmosphericVerticalDividerBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0000F2FE" Offset="0.0" />
        <GradientStop Color="#4000F2FE" Offset="0.3" />
        <GradientStop Color="#358A2BE2" Offset="0.7" />
        <GradientStop Color="#008A2BE2" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Native glass hierarchy surfaces -->
    <LinearGradientBrush x:Key="AppBackgroundCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C0101827" Offset="0.0" />
        <GradientStop Color="#A5080C14" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppBackgroundSecondaryCardBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#B00C1320" Offset="0.0" />
        <GradientStop Color="#98070A12" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppBackgroundElevatedBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#B80E1524" Offset="0.0" />
        <GradientStop Color="#A0080B14" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AppBackgroundHoverBrush" Color="#FFFFFF" Opacity="0.08" />

    <!-- Fluent CardStroke -->
    <LinearGradientBrush x:Key="AppBorderSubduedBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#35FFFFFF" Offset="0.0" />
        <GradientStop Color="#10FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppBorderBrightBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#6000F2FE" Offset="0.0" />
        <GradientStop Color="#25FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="DownloadFlowBrush" Color="{StaticResource DownloadPrimaryColor}" />
    <SolidColorBrush x:Key="DownloadGlowBrush" Color="{StaticResource DownloadGlowColor}" />
    <SolidColorBrush x:Key="DownloadDimBrush" Color="{StaticResource DownloadDimColor}" />
    <SolidColorBrush x:Key="UploadFlowBrush" Color="{StaticResource UploadPrimaryColor}" />
    <SolidColorBrush x:Key="UploadGlowBrush" Color="{StaticResource UploadGlowColor}" />
    <SolidColorBrush x:Key="UploadDimBrush" Color="{StaticResource UploadDimColor}" />

    <!-- Ultra-punchy hero value brushes with subtle tint -->
    <SolidColorBrush x:Key="DownloadValueBrush" Color="#F0FFF8" />
    <SolidColorBrush x:Key="UploadValueBrush" Color="#F0F8FF" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="{StaticResource AccentSurfaceColor}" />
    <SolidColorBrush x:Key="AccentSurfaceStrongBrush" Color="{StaticResource AccentSurfaceStrongColor}" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}" />
    <SolidColorBrush x:Key="AccentBorderStrongBrush" Color="{StaticResource AccentBorderStrongColor}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentFocusBrush" Color="{StaticResource AccentFocusColor}" />
    <SolidColorBrush x:Key="StatusLiveBrush" Color="{StaticResource StatusLiveColor}" />
    <SolidColorBrush x:Key="PinActiveSurfaceBrush" Color="#3000E599" />
    <SolidColorBrush x:Key="PinActiveBorderBrush" Color="#8000E599" />

    <!-- Highly Saturated Volumetric Waveform Gradients -->
    <LinearGradientBrush x:Key="DownloadAreaBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4800E599" Offset="0" />
        <GradientStop Color="#1800E599" Offset="0.65" />
        <GradientStop Color="#0000E599" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="UploadAreaBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4400A3FF" Offset="0" />
        <GradientStop Color="#1500A3FF" Offset="0.65" />
        <GradientStop Color="#0000A3FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderDividerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#2500F2FE" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Rich Atmospheric Illumination Blooms (Clearly visible at runtime & idle) -->
    <!-- Emerald Download Aurora Bloom -->
    <LinearGradientBrush x:Key="AtmosphereDownloadBloomBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4200E599" Offset="0.0" />
        <GradientStop Color="#2000E599" Offset="0.45" />
        <GradientStop Color="#0000E599" Offset="0.9" />
    </LinearGradientBrush>

    <!-- Electric Blue Upload Aurora Bloom -->
    <LinearGradientBrush x:Key="AtmosphereUploadBloomBrush" StartPoint="1,0" EndPoint="0,1">
        <GradientStop Color="#4500A3FF" Offset="0.0" />
        <GradientStop Color="#2200A3FF" Offset="0.45" />
        <GradientStop Color="#0000A3FF" Offset="0.9" />
    </LinearGradientBrush>

    <!-- Deep Plum / Imperial Violet Secondary Atmosphere Core -->
    <LinearGradientBrush x:Key="AtmospherePlumCoreBrush" StartPoint="0,0.8" EndPoint="0.8,0">
        <GradientStop Color="#3E8A2BE2" Offset="0.0" />
        <GradientStop Color="#1E4C1D95" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Open Waveform Chamber Floor -->
    <LinearGradientBrush x:Key="AtmosphereWaveformFloorBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#120A1322" Offset="0" />
        <GradientStop Color="#28080C16" Offset="0.7" />
        <GradientStop Color="#35060810" Offset="1" />
    </LinearGradientBrush>

    <!-- Active Process Row Local Illumination -->
    <LinearGradientBrush x:Key="AtmosphereActiveRowHighlightBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#2500E599" Offset="0.0" />
        <GradientStop Color="#0800E599" Offset="0.3" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Monogram Jewel Finish -->
    <LinearGradientBrush x:Key="MonogramJewelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1C263B" Offset="0.0" />
        <GradientStop Color="#0E1422" Offset="1.0" />
    </LinearGradientBrush>


    <!-- ============================================ -->
    <!-- BUTTON STYLES -->
    <!-- ============================================ -->

    <!-- Base icon button: transparent, hover reveals surface -->
    <Style x:Key="InstrumentIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppBackgroundHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppBackgroundCardBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource InstrumentIconButtonStyle}">
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="InstrumentTextButtonStyle" TargetType="Button" BasedOn="{StaticResource InstrumentIconButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Segmented toggle: clear selected (accent underline + accent text) vs unselected (muted) -->
    <Style x:Key="SegmentedToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8,16,10" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" />
                        <!-- Bottom accent indicator for selected state -->
                        <Border x:Name="SelectionIndicator" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Width="20" CornerRadius="1" Background="Transparent" Margin="0,0,0,2" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextSecondaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextPrimaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentPrimaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
