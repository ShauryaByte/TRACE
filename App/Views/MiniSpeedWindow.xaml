<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NetStats.UI.Views.MiniSpeedWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="">
    <Border x:Name="RootBorder"
            Background="{StaticResource SolidBackgroundElevatedBrush}"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            PointerPressed="OnWindowPointerPressed"
            PointerMoved="OnWindowPointerMoved"
            PointerReleased="OnWindowPointerReleased"
            PointerCaptureLost="OnWindowPointerCaptureLost">
        <!-- Compact instrument grid: download | upload | unit | spacer | privacy. The window is
             sized to 204x36 in code and the grid must never widen it. -->
        <Grid Height="36" Padding="9,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="6" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Download -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2.5" VerticalAlignment="Center">
                <TextBlock Text="&#x2193;" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource DownloadFlowBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="DownloadValueText" Text="0.0" Width="40"
                           FontFamily="{StaticResource MonospaceFontFamily}" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Upload -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2.5" VerticalAlignment="Center">
                <TextBlock Text="&#x2191;" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource UploadFlowBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="UploadValueText" Text="0.0" Width="40"
                           FontFamily="{StaticResource MonospaceFontFamily}" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Shared Unit: appears ONLY ONCE, smaller and muted -->
            <TextBlock x:Name="SharedUnitText" Grid.Column="4" Text="Mbps" FontSize="8.5"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />

            <!-- Privacy state: muted neutral when inactive, selected accent when active -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon x:Name="MiniMicIcon" Glyph="&#xE720;" FontSize="10"
                          Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <FontIcon x:Name="MiniCameraIcon" Glyph="&#xE722;" FontSize="10"
                          Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>