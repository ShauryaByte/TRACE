<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NetStats.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NetStats.UI.Views"
    Title="TRACE">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!-- Translucent main surface: lets native Windows 11 Desktop Acrylic depth and blur show through -->
    <Grid x:Name="RootWindowGrid" Background="{StaticResource MicaSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0,144,0" Background="Transparent">
            <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource HeaderDividerBrush}" />
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- Spacer: allows right column to always be fully visible -->
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" MinWidth="102" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Grid Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGlowBrush}" Opacity="0.30" />
                        <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource StatusLiveBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="TRACE" FontFamily="{StaticResource AppFontFamily}" FontSize="10.5" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Button x:Name="CollapseButton" IsTabStop="False" AllowFocusOnInteraction="False" UseSystemFocusVisuals="False" Click="OnCollapseToggleClicked" Style="{StaticResource TitleBarIconButtonStyle}" ToolTipService.ToolTip="Collapse instrument" AutomationProperties.AutomationId="CollapseButton" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" Margin="2,0,0,0">
                        <FontIcon x:Name="CollapseIcon" Glyph="&#xE70E;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" IsTabStop="False" AllowFocusOnInteraction="False" UseSystemFocusVisuals="False" Click="OnSettingsToggleClicked" Style="{StaticResource TitleBarIconButtonStyle}" ToolTipService.ToolTip="Instrument settings" AutomationProperties.AutomationId="SettingsButton" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0">
                        <FontIcon x:Name="SettingsIcon" Glyph="&#xE713;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>

                    <Button x:Name="PinButton" IsTabStop="False" AllowFocusOnInteraction="False" UseSystemFocusVisuals="False" Click="OnPinClicked" Style="{StaticResource TitleBarIconButtonStyle}" ToolTipService.ToolTip="Always on top: Off" AutomationProperties.AutomationId="PinButton" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0">
                        <Grid Width="22" Height="22">
                            <Border x:Name="PinActiveBackground" Background="{StaticResource PinActiveSurfaceBrush}" BorderBrush="{StaticResource PinActiveBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Opacity="0" />
                            <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Precision hairline grouping instrument controls and privacy sensors -->
                    <Border Width="1" Height="13" Background="{StaticResource AppBorderSubduedBrush}" VerticalAlignment="Center" Margin="3,0" Opacity="0.5" />

                    <Button x:Name="MicButton" IsTabStop="False" AllowFocusOnInteraction="False" UseSystemFocusVisuals="False" Style="{StaticResource TitleBarIconButtonStyle}" ToolTipService.ToolTip="Microphone privacy" AutomationProperties.AutomationId="MicButton" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0">
                        <FontIcon x:Name="MicIcon" Glyph="&#xE720;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Button.Flyout>
                            <Flyout x:Name="MicFlyout" Placement="BottomEdgeAlignedRight" Opening="OnMicFlyoutOpening">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="{StaticResource AppBackgroundCardBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AppBorderSubduedBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Padding" Value="14,12" />
                                        <Setter Property="MinWidth" Value="210" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Spacing="9">
                                    <TextBlock Text="MICROPHONE" FontSize="9" FontWeight="SemiBold" CharacterSpacing="90" Foreground="{StaticResource TextMutedBrush}" />

                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock x:Name="MicFlyoutStatus" Text="NOT IN USE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="MicFlyoutAttributionLabel" Text="Status" FontSize="8" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="MicFlyoutAttributionText" Text="No current activity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                    </StackPanel>

                                    <Border Height="1" Background="{StaticResource AppBorderSubduedBrush}" Margin="0,2" />

                                    <Button Click="OnOpenMicPrivacySettingsClicked" Style="{StaticResource InstrumentTextButtonStyle}" HorizontalAlignment="Left" Padding="0,2">
                                        <TextBlock Text="Windows Privacy Settings &#x2192;" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="CameraButton" IsTabStop="False" AllowFocusOnInteraction="False" UseSystemFocusVisuals="False" Style="{StaticResource TitleBarIconButtonStyle}" ToolTipService.ToolTip="Camera privacy" AutomationProperties.AutomationId="CameraButton" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0">
                        <FontIcon x:Name="CameraIcon" Glyph="&#xE722;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Button.Flyout>
                            <Flyout x:Name="CameraFlyout" Placement="BottomEdgeAlignedRight" Opening="OnCameraFlyoutOpening">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="{StaticResource AppBackgroundCardBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AppBorderSubduedBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Padding" Value="14,12" />
                                        <Setter Property="MinWidth" Value="210" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Spacing="9">
                                    <TextBlock Text="CAMERA" FontSize="9" FontWeight="SemiBold" CharacterSpacing="90" Foreground="{StaticResource TextMutedBrush}" />

                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock x:Name="CameraFlyoutStatus" Text="NOT IN USE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="CameraFlyoutAttributionLabel" Text="Status" FontSize="8" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="CameraFlyoutAttributionText" Text="No current activity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                    </StackPanel>

                                    <Border Height="1" Background="{StaticResource AppBorderSubduedBrush}" Margin="0,2" />

                                    <Button Click="OnOpenCameraPrivacySettingsClicked" Style="{StaticResource InstrumentTextButtonStyle}" HorizontalAlignment="Left" Padding="0,2">
                                        <TextBlock Text="Windows Privacy Settings &#x2192;" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <views:DashboardView x:Name="MainDashboard" Grid.Row="1" />

        <!-- Redesigned In-App Settings Overlay Panel -->
        <Grid x:Name="SettingsOverlay" Grid.Row="1" Background="{StaticResource SettingsOverlayBrush}" Visibility="Collapsed">
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" />
                </TransitionCollection>
            </Grid.Transitions>

            <ScrollViewer x:Name="SettingsScrollViewer" AutomationProperties.AutomationId="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,12,18,28">
                <StackPanel Spacing="16" MaxWidth="540">
                    <!-- Settings Header -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{StaticResource AccentTextBrush}" />
                                <TextBlock Text="SETTINGS" FontSize="12" FontWeight="SemiBold" CharacterSpacing="100" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="PREFERENCES &amp; DISPLAY" FontSize="8" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <Button x:Name="CloseSettingsButton" Grid.Column="1" Click="OnCloseSettingsClicked" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Close settings" Width="28" Height="28">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{StaticResource AppBorderBrightBrush}" />

                    <!-- Section: Background Atmosphere (10 Presets: 4 Tints, 6 Gradients) -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="BACKGROUND ATMOSPHERE" FontSize="9" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource AccentTextBrush}" />
                            <TextBlock Text="Glass Tint &amp; Gradients" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Solid / Atmospheric Tints -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="ATMOSPHERIC TINTS" FontSize="8" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{StaticResource TextMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <!-- Midnight -->
                                <Button x:Name="MidnightSwatch" Click="OnBackgroundCardClicked" Tag="Midnight" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Midnight (Neutral Dark Slate)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Fill="#0D1117" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#30FFFFFF" StrokeThickness="1" />
                                        <FontIcon x:Name="MidnightCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Obsidian -->
                                <Button x:Name="ObsidianSwatch" Click="OnBackgroundCardClicked" Tag="Obsidian" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Obsidian (Pitch Stealth Charcoal)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Fill="#050608" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#20FFFFFF" StrokeThickness="1" />
                                        <FontIcon x:Name="ObsidianCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Deep Ocean -->
                                <Button x:Name="DeepOceanSwatch" Click="OnBackgroundCardClicked" Tag="DeepOcean" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Deep Ocean (Marine Abyss)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#0B2540" Offset="0" />
                                                    <GradientStop Color="#05101C" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <FontIcon x:Name="DeepOceanCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Arctic Night -->
                                <Button x:Name="ArcticNightSwatch" Click="OnBackgroundCardClicked" Tag="ArcticNight" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Arctic Night (Glacial Twilight Slate)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#143048" Offset="0" />
                                                    <GradientStop Color="#0A1826" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <FontIcon x:Name="ArcticNightCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dynamic Atmospheric Gradients -->
                        <StackPanel Spacing="8" Margin="0,4,0,0">
                            <TextBlock Text="ATMOSPHERIC GRADIENTS" FontSize="8" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{StaticResource TextMutedBrush}" />
                            <!-- Row 1: Indigo Night, Emerald Night, Violet Night -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <!-- Indigo Night -->
                                <Button x:Name="IndigoNightSwatch" Click="OnBackgroundCardClicked" Tag="IndigoNight" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Indigo Night (Deep Sapphire Indigo)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#222868" Offset="0" />
                                                    <GradientStop Color="#0D1032" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <FontIcon x:Name="IndigoNightCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Emerald Night -->
                                <Button x:Name="EmeraldNightSwatch" Click="OnBackgroundCardClicked" Tag="EmeraldNight" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Emerald Night (Boreal Pine)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#0C3B28" Offset="0" />
                                                    <GradientStop Color="#051B12" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <FontIcon x:Name="EmeraldNightCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Violet Night -->
                                <Button x:Name="VioletNightSwatch" Click="OnBackgroundCardClicked" Tag="VioletNight" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Violet Night (Royal Amethyst)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3A155C" Offset="0" />
                                                    <GradientStop Color="#140722" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <FontIcon x:Name="VioletNightCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!-- Row 2: Cosmic, Aurora, Ember -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                <!-- Cosmic -->
                                <Button x:Name="CosmicSwatch" Click="OnBackgroundCardClicked" Tag="Cosmic" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Cosmic (Nebula Magenta / Sapphire)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#461650" Offset="0" />
                                                    <GradientStop Color="#14183E" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <FontIcon x:Name="CosmicCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Aurora -->
                                <Button x:Name="AuroraBackgroundSwatch" Click="OnBackgroundCardClicked" Tag="Aurora" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Aurora (Northern Lights Cyan / Pine)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#09484B" Offset="0" />
                                                    <GradientStop Color="#072722" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <FontIcon x:Name="AuroraBackgroundCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Ember -->
                                <Button x:Name="EmberSwatch" Click="OnBackgroundCardClicked" Tag="Ember" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Ember (Volcanic Mahogany)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#4F1820" Offset="0" />
                                                    <GradientStop Color="#1C090D" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <FontIcon x:Name="EmberCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource AppBorderSubduedBrush}" />

                    <!-- Section: Appearance & Colors -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="ACCENT THEME" FontSize="9" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource AccentTextBrush}" />
                            <TextBlock Text="Color Palette" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Solid Accents -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="SOLID ACCENTS" FontSize="8" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{StaticResource TextMutedBrush}" />
                            <!-- Row 1: Cyan, Blue, Violet, Magenta -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <!-- Cyan -->
                                <Button x:Name="ElectricCyanSwatch" Click="OnAccentCardClicked" Tag="ElectricCyan" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Electric Cyan" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Fill="#30C7DD" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <FontIcon x:Name="ElectricCyanCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#0E121A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Cobalt Blue -->
                                <Button x:Name="CobaltBlueSwatch" Click="OnAccentCardClicked" Tag="CobaltBlue" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Cobalt Blue" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Fill="#3B82F6" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <FontIcon x:Name="CobaltBlueCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Neon Violet -->
                                <Button x:Name="VioletSwatch" Click="OnAccentCardClicked" Tag="Violet" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Neon Violet" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Fill="#A855F7" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <FontIcon x:Name="VioletCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Laser Magenta -->
                                <Button x:Name="MagentaSwatch" Click="OnAccentCardClicked" Tag="Magenta" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Laser Magenta" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Fill="#EC4899" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <FontIcon x:Name="MagentaCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!-- Row 2: Crimson, Amber, Emerald, Mint -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <!-- Cyber Crimson -->
                                <Button x:Name="CrimsonSwatch" Click="OnAccentCardClicked" Tag="Crimson" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Cyber Crimson" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Fill="#EF4444" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <FontIcon x:Name="CrimsonCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Cockpit Amber -->
                                <Button x:Name="AmberSwatch" Click="OnAccentCardClicked" Tag="Amber" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Cockpit Amber" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Fill="#F59E0B" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <FontIcon x:Name="AmberCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#0E121A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Phosphor Emerald -->
                                <Button x:Name="EmeraldSwatch" Click="OnAccentCardClicked" Tag="Emerald" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Phosphor Emerald" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Fill="#10B981" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <FontIcon x:Name="EmeraldCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#0E121A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Hyper Mint -->
                                <Button x:Name="MintSwatch" Click="OnAccentCardClicked" Tag="Mint" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Hyper Mint" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Fill="#14B8A6" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <FontIcon x:Name="MintCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#0E121A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Gradient Accents -->
                        <StackPanel Spacing="6" Margin="0,4,0,0">
                            <TextBlock Text="DYNAMIC GRADIENTS" FontSize="8" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{StaticResource TextMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <!-- Cyberpunk -->
                                <Button x:Name="CyberpunkSwatch" Click="OnAccentCardClicked" Tag="Cyberpunk" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Cyberpunk Neon (Pink / Cyan)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF2A85" Offset="0" />
                                                    <GradientStop Color="#00F5FF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <FontIcon x:Name="CyberpunkCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Sunset Blaze -->
                                <Button x:Name="SunsetSwatch" Click="OnAccentCardClicked" Tag="Sunset" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Sunset Blaze (Orange / Magenta)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF5E3A" Offset="0" />
                                                    <GradientStop Color="#FF2A6D" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <FontIcon x:Name="SunsetCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <!-- Aurora Borealis -->
                                <Button x:Name="AuroraSwatch" Click="OnAccentCardClicked" Tag="Aurora" Width="36" Height="36" CornerRadius="18" Padding="0" Style="{StaticResource InstrumentIconButtonStyle}" ToolTipService.ToolTip="Aurora Borealis (Lime / Cyan)" BorderThickness="2">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#00FF87" Offset="0" />
                                                    <GradientStop Color="#60EFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <FontIcon x:Name="AuroraCheck" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="#0E121A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource AppBorderSubduedBrush}" />

                    <!-- Section: Telemetry Speed Unit -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="TELEMETRY DISPLAY" FontSize="9" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource AccentTextBrush}" />
                        <TextBlock Text="Throughput Measurement Unit" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="MegabytesUnitCard" Grid.Column="0" Click="OnSpeedUnitCardClicked" Tag="MegabytesPerSecond" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,12" CornerRadius="{StaticResource SurfaceCornerRadius}" Style="{StaticResource InstrumentIconButtonStyle}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="MB/s" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <FontIcon x:Name="MegabytesUnitCheck" Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock Text="Megabytes per second (Transfer rate)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="MbpsUnitCard" Grid.Column="2" Click="OnSpeedUnitCardClicked" Tag="Mbps" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,12" CornerRadius="{StaticResource SurfaceCornerRadius}" Style="{StaticResource InstrumentIconButtonStyle}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Mbps" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <FontIcon x:Name="MbpsUnitCheck" Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock Text="Megabits per second (Bandwidth rate)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource AppBorderSubduedBrush}" />

                    <!-- Section: Window Behavior -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="WINDOW BEHAVIOR" FontSize="9" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource AccentTextBrush}" />
                        <Grid Padding="12,10" Background="{StaticResource AppBackgroundElevatedBrush}" CornerRadius="{StaticResource SurfaceCornerRadius}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Always On Top" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Keep instrument floating above all other windows" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AlwaysOnTopToggle" Grid.Column="1" OnContent="" OffContent="" Toggled="OnAlwaysOnTopToggled" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="0" Padding="0" />
                        </Grid>


                        <Grid Padding="12,10" Background="{StaticResource AppBackgroundElevatedBrush}" CornerRadius="{StaticResource SurfaceCornerRadius}" Margin="0,4,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Mini Speed Overlay" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Automatically docks an ultra-compact live throughput bar near your taskbar whenever TRACE is minimized." FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Done / Close Button -->
                    <Button x:Name="DoneSettingsButton" Click="OnCloseSettingsClicked" Style="{StaticResource InstrumentTextButtonStyle}" HorizontalAlignment="Right" Padding="16,8" Margin="0,4,0,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="DONE" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" />
                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Subtle Section Divider -->
                    <Border Height="1" Background="{StaticResource AppBorderSubduedBrush}" Margin="0,4,0,8" />

                    <!-- Section: About Developer Card Footer -->
                    <StackPanel Spacing="8" Margin="0,0,0,16">
                        <TextBlock Text="ABOUT DEVELOPER" FontSize="9" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource AccentTextBrush}" />
                        <Border Background="{StaticResource AppBackgroundElevatedBrush}"
                                BorderBrush="{StaticResource AppBorderSubduedBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource SurfaceCornerRadius}"
                                Padding="14,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="By Shaurya Singh" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />

                                <Border Height="1" Background="{StaticResource AppBorderSubduedBrush}" Margin="0,2,0,2" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Reach out to me" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                    <Grid Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="shauryaofficialx@gmail.com" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="CopyEmailButton" Grid.Column="1" Click="OnCopyEmailClicked"
                                                PointerEntered="OnCopyEmailPointerEntered"
                                                PointerExited="OnCopyEmailPointerExited"
                                                Style="{StaticResource InstrumentIconButtonStyle}"
                                                ToolTipService.ToolTip="Copy email address"
                                                AutomationProperties.AutomationId="CopyDeveloperEmail"
                                                AutomationProperties.Name="CopyDeveloperEmail"
                                                Padding="8,4" CornerRadius="4" MinWidth="0" MinHeight="0"
                                                Background="{StaticResource AppBackgroundSecondaryCardBrush}"
                                                BorderBrush="{StaticResource AppBorderSubduedBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon x:Name="CopyEmailIcon" Glyph="&#xE8C8;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="CopyEmailLabel" Text="Copy" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Window>
